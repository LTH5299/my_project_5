# Chế độ SePay: mock (giả lập, mặc định) hoặc live (tạo QR qua qr.sepay.vn)
SEPAY_MODE=mock
# Khóa xác thực webhook SePay: SePay gửi header "Authorization: Apikey <khóa>"
SEPAY_WEBHOOK_KEY=dev-sepay-key
# Tài khoản nhận tiền do Chủ shop cấu hình trên SePay
SEPAY_BANK_CODE=MBBank
SEPAY_BANK_BIN=970422
SEPAY_BANK_NAME=Ngân hàng TMCP Quân đội (MB)
SEPAY_ACCOUNT_NUMBER=0000000000
SEPAY_ACCOUNT_NAME=CONG TY NEXT FASHION
# Thông tin liên hệ hiển thị trên trang đặt hàng thành công và email
NEXT_PUBLIC_HOTLINE=1900 0000
NEXT_PUBLIC_ZALO_URL=https://zalo.me/
# Bật trang công cụ giả lập (/dev) khi chạy production để demo
ENABLE_DEV_TOOLS=false
